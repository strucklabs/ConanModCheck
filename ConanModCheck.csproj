<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Funktionszeiger für die Oodle-Anbindung -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>ConanModCheck-cli</AssemblyName>
    <RootNamespace>ConanModCheck</RootNamespace>
    <Version>0.1.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>Gui\Assets\ConanModCheck.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- dotnet publish -c Release: eine einzelne EXE, die ohne installiertes .NET läuft -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Die Oberfläche ist ein eigenes Projekt im Unterordner und nutzt diese Quelltexte mit -->
    <Compile Remove="Gui\**" />
    <!-- Hilfsskripte (z. B. Icon-Erzeugung) laufen eigenständig als dateibasierte Programme -->
    <Compile Remove="tools\**" />
    <None Remove="Gui\**" />
    <EmbeddedResource Remove="Gui\**" />
  </ItemGroup>

</Project>
