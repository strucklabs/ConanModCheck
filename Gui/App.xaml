<Application x:Class="ConanModCheck.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Logo „Mod-Puzzleteil“ als Vektor, gleiche Zeichnung wie tools/MakeIcon.cs -->
        <DrawingImage x:Key="Logo">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#3A2E28" Geometry="M18,0 H82 A18,18 0 0 1 100,18 V82 A18,18 0 0 1 82,100 H18 A18,18 0 0 1 0,82 V18 A18,18 0 0 1 18,0 Z" />
                    <GeometryDrawing Brush="#D9B26F">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup FillRule="Nonzero">
                                <RectangleGeometry Rect="26,32,44,44" RadiusX="4" RadiusY="4" />
                                <EllipseGeometry Center="48,32" RadiusX="10" RadiusY="10" />
                                <EllipseGeometry Center="70,54" RadiusX="10" RadiusY="10" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M35,55 L45,65 L61,44">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#3A2E28" Thickness="7" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <!-- Gelb: Hinweis, auf den man achten sollte; Rot: Warnung -->
        <Style x:Key="Notice" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B5000" />
            <Setter Property="Background" Value="#FFF4CC" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="Warning" TargetType="TextBlock" BasedOn="{StaticResource Notice}">
            <Setter Property="Foreground" Value="#9B1C1C" />
            <Setter Property="Background" Value="#FDECEC" />
        </Style>
        <Style x:Key="ReportBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <!-- Zeilentext in Bäumen: Auf farbigem Hintergrund bleibt die Schrift dunkel, auch in der ausgewählten Zeile
         (sonst färbt die Auswahl sie weiß und sie ist auf Gelb nicht mehr zu lesen) -->
    <Style x:Key="TreeRowText" TargetType="TextBlock">
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasRowBackground}" Value="True">
                <Setter Property="Foreground" Value="#222" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- Platz für den Koordinaten-Link: ohne Koordinaten ganz ausblenden, sonst bleibt in der Auswahl ein leeres Kästchen -->
    <Style x:Key="TreeCoordBox" TargetType="TextBlock">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Coords}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- Koordinaten-Link in Bäumen: in der ausgewählten (blau hinterlegten) Zeile weiß, sonst unlesbar -->
    <Style x:Key="TreeCoordLink" TargetType="Hyperlink">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                <Setter Property="Foreground" Value="White" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</Application.Resources>
</Application>
