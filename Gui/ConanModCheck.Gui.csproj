<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Die Oberfläche ist das Hauptprogramm, die Konsolenfassung heißt ConanModCheck-cli -->
    <AssemblyName>ConanModCheck</AssemblyName>
    <RootNamespace>ConanModCheck.Gui</RootNamespace>
    <Version>0.2.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ConanModCheck.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Prüf- und Bereinigungslogik aus dem Hauptordner, ohne den Konsolen-Einstieg -->
    <Compile Include="..\*.cs" Exclude="..\Program.cs" Link="Core\%(Filename)%(Extension)" />
    <Compile Include="..\IoStore\*.cs" Link="Core\IoStore\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF lässt System.IO aus den impliziten usings weg, die geteilten Quelltexte brauchen es -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ConanModCheck.ico" />
    <!-- Lizenztext gehört neben die EXE -->
    <None Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

</Project>
