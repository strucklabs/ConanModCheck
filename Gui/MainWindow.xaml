<Window x:Class="ConanModCheck.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ConanModCheck.Gui"
        Title="ConanModCheck – Mod-Reste im Spielstand finden und entfernen"
        Width="1180" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/ConanModCheck.ico"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Linke Spalte: Auswahl. Füllt die Höhe; wird es zu eng (lange Mod-Liste, kleines Fenster),
             rollt die ganze Spalte, statt etwas abzuschneiden -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <local:FitGrid>
            <local:FitGrid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" MinHeight="210" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" MinHeight="100" />
            </local:FitGrid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <Image Source="{StaticResource Logo}" Width="40" Height="40" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ConanModCheck" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Mod-Reste im Spielstand finden und entfernen" Foreground="#666" />
                </StackPanel>
            </StackPanel>
            <GroupBox Grid.Row="1" Header="1. Spielstand (game.db)">
                <StackPanel>
                    <TextBlock x:Name="DbPathText" Text="Noch keiner ausgewählt" TextWrapping="Wrap" />
                    <Button Content="Spielstand auswählen …" HorizontalAlignment="Left" Margin="0,8,0,0" Click="ChooseDb_Click" />
                    <TextBlock Style="{StaticResource Notice}"
                               Text="Liegt beim Server unter ConanSandbox\Saved. Den Server vor dem Kopieren stoppen. Am besten mit einer Kopie arbeiten." />
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="2. Mod-Dateien (optional)">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}"
                               Text="Zip, .pak oder .utoc von Mods. Nur mit der Mod-Datei lassen sich auch ihre Items erkennen; was entfernt werden soll, wird danach in der Übersicht angehakt. Dateien lassen sich hierher ziehen." />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Hinzufügen …" Click="AddMods_Click" />
                        <Button Content="Ordner …" Margin="6,0,0,0" Click="AddModFolder_Click"
                                ToolTip="Einen ganzen Ordner mit Mods, z. B. ConanSandbox\Saved\ExtractedMods" />
                        <Button Content="Entfernen" Margin="6,0,0,0" Click="RemoveMod_Click" />
                    </StackPanel>
                    <ListBox x:Name="ModList" MinHeight="60" SelectionMode="Extended" />
                </DockPanel>
            </GroupBox>

            <Button x:Name="AnalyzeButton" Grid.Row="3" Content="Prüfen" FontWeight="SemiBold"
                    MinHeight="36" IsDefault="True" Click="Analyze_Click" />

            <Expander Grid.Row="4" Header="Einstellungen" Margin="0,12,0,0">
                <Border Margin="0,6,0,0" Padding="10" Background="#F5F5F3" BorderBrush="#DDDAD2" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Sprache / Language" />
                    <ComboBox x:Name="LanguageBox" Margin="0,2,0,8" SelectionChanged="Language_Changed">
                        <ComboBoxItem Content="English" />
                        <ComboBoxItem Content="Deutsch" />
                    </ComboBox>
                    <TextBlock Text="Conan Exiles-Ordner (leer = über Steam suchen)" />
                    <DockPanel Margin="0,2,0,8">
                        <Button DockPanel.Dock="Right" Content="…" Padding="8,2" Margin="4,0,0,0" Click="ChooseGame_Click" />
                        <TextBox x:Name="GameDirBox" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="Oodle-DLL (leer = automatisch suchen)" />
                    <DockPanel Margin="0,2,0,0">
                        <Button DockPanel.Dock="Right" Content="…" Padding="8,2" Margin="4,0,0,0" Click="ChooseOodle_Click" />
                        <TextBox x:Name="OodleBox" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="OodleInfoText" TextWrapping="Wrap" Margin="0,6,0,0" Text="Oodle wird beim Prüfen gesucht." />
                    <Button x:Name="CopyOodleButton" Content="Neben das Programm kopieren" HorizontalAlignment="Left"
                            Margin="0,6,0,0" Visibility="Collapsed" Click="CopyOodle_Click" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Mod- und Spieldateien sind mit Oodle gepackt. Die Bibliothek oo2core_*_win64.dll liegt vielen anderen Spielen bei." />
                </StackPanel>
                </Border>
            </Expander>

            <GroupBox Grid.Row="5" Header="Verlauf" Margin="0,12,0,0">
                <TextBox x:Name="LogBox" Style="{StaticResource ReportBox}" FontSize="11.5" BorderThickness="0" TextWrapping="Wrap" />
            </GroupBox>
        </local:FitGrid>
        </ScrollViewer>

        <!-- Rechte Spalte: Ergebnisse -->
        <TabControl x:Name="Tabs" Grid.Column="2">
            <TabItem Header="Übersicht">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.3*" MinHeight="120" />
                    </Grid.RowDefinitions>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Alle Mod-Ordner, von denen etwas im Spielstand steckt. Haken bei allem setzen, was entfernt werden soll. Bericht und Vorschau richten sich nach dieser Auswahl. Eine Zeile anklicken zeigt unten die Einzelheiten." />
                    <DataGrid x:Name="FolderGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                              HorizontalGridLinesBrush="#DDD" RowHeight="24" SelectionChanged="FolderGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Entfernen" Width="70" MinWidth="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Remove, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Mod-Ordner" Binding="{Binding Folder}" Width="2*" MinWidth="140" IsReadOnly="True" />
                            <DataGridTextColumn Header="Mod-Datei" Binding="{Binding ModName}" Width="*" MinWidth="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="Mod-Controller" Binding="{Binding ControllerMark}" Width="95" MinWidth="95" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <!-- Rechtsbündig, damit die Häkchen auch bei "2 ✓" untereinander stehen -->
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="Margin" Value="0,0,28,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Objekte" Binding="{Binding Objects}" Width="70" MinWidth="70" IsReadOnly="True" />
                            <DataGridTextColumn Header="Bauteile" Binding="{Binding Pieces}" Width="70" MinWidth="70" IsReadOnly="True" />
                            <DataGridTextColumn Header="Items" Binding="{Binding Items}" Width="70" MinWidth="70" IsReadOnly="True" />
                            <DataGridTextColumn Header="Erlernt" Binding="{Binding Learned}" Width="70" MinWidth="70" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Warnungen" Width="85" MinWidth="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding WarningMark}" ToolTip="{Binding WarningTip}" Foreground="#9B1C1C" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent" ShowsPreview="False" />
                    <!-- Einzelheiten der angeklickten Zeile, wie der Mod-Abschnitt im Bericht -->
                    <Border Grid.Row="3" BorderBrush="#CCC" BorderThickness="1">
                        <Grid>
                            <FlowDocumentScrollViewer x:Name="ModDetailView" PreviewMouseWheel="DocumentView_MouseWheel"
                                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" />
                            <TextBlock x:Name="ModDetailHint" Style="{StaticResource Hint}" Margin="14,10,0,0"
                                       Text="Eine Zeile oben anklicken, um zu sehen, was von dieser Mod im Spielstand steckt und was beim Entfernen verloren geht." />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Besitz">
                <DockPanel Margin="8">
                    <!-- Bricht bei schmalem Fenster in eine zweite Zeile um, statt Suchfeld oder Knöpfe zu verdrängen -->
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,2">
                        <TextBlock Text="Item suchen:" VerticalAlignment="Center" Margin="0,0,6,6" />
                        <TextBox x:Name="OwnershipSearchBox" Width="200" Margin="0,0,0,6" VerticalContentAlignment="Center" KeyDown="OwnershipSearch_KeyDown"
                                 ToolTip="Teil eines Item- oder Mod-Namens, z. B. „Sternenmetall“. Leer lassen für alles." />
                        <Button Content="Suchen" Margin="6,0,0,6" Click="SearchOwnership_Click" />
                        <ComboBox x:Name="ItemFilterBox" Margin="12,0,0,6" Width="190" VerticalContentAlignment="Center"
                                  SelectedIndex="0" SelectionChanged="ItemFilter_Changed">
                            <ComboBoxItem Content="Alle Items" />
                            <ComboBoxItem Content="Items aus allen Mods" />
                            <ComboBoxItem Content="Items aus geladenen Mods" />
                            <ComboBoxItem Content="Items aus angehakten Mods" />
                        </ComboBox>
                        <Button Content="Mod-Inhalte aufklappen" Margin="6,0,0,6" Click="ExpandMarked_Click"
                                ToolTip="Klappt alle Zweige mit Mod-Inhalten auf und alle anderen zu." />
                        <Button Content="Alles zuklappen" Margin="6,0,0,6" Click="CollapseAll_Click" />
                        <Button Content="Als Text speichern …" Margin="6,0,0,6" Click="SaveOwnership_Click" />
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}"
                               Text="Gelb: Inhalte aus Mods, rot: aus Mods, die in der Übersicht zum Entfernen angehakt sind – übergeordnete Zeilen tragen die Farbe ihrer Inhalte. Zahlen in eckigen Klammern sind Stückzahlen, Namen in eckigen Klammern die Mod. Doppelklick auf ein Objekt springt ins Verzeichnis; Rechtsklick öffnet ein Menü (Karte, Verzeichnis, Teleport-Befehl, Zeile kopieren); Strg+C kopiert die Zeile." />
                    <TreeView x:Name="OwnershipTree" VirtualizingStackPanel.IsVirtualizing="True" PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                              MouseDoubleClick="OwnershipTree_MouseDoubleClick" PreviewKeyDown="OwnershipTree_PreviewKeyDown" ContextMenuOpening="OwnershipTree_ContextMenuOpening">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Markierung in den Farben der Karte -->
                                    <Rectangle Width="9" Height="9" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding Marker}" />
                                    <TextBlock Text="{Binding Text}" FontWeight="{Binding Weight}" Padding="3,1" Background="{Binding RowBackground}"
                                               Style="{StaticResource TreeRowText}" />
                                    <!-- Koordinaten: Klick springt zur Karte -->
                                    <TextBlock Margin="8,1,0,0" Style="{StaticResource TreeCoordBox}"><Hyperlink Click="TreeCoords_Click" ToolTip="Auf der Karte zeigen" Style="{StaticResource TreeCoordLink}"><Run Text="{Binding Coords, Mode=OneWay}" /></Hyperlink></TextBlock>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="ShowOnMapItem" Header="Auf der Karte zeigen" Click="TreeShowOnMap_Click" />
                                <MenuItem x:Name="ShowInDirectoryItem" Header="Im Verzeichnis zeigen" Click="TreeShowInDirectory_Click" InputGestureText="Doppelklick" />
                                <MenuItem x:Name="CopyTeleportItem" Header="Teleport-Befehl kopieren" Click="CopyTeleport_Click" />
                                <MenuItem x:Name="CopyTreeLineItem" Header="Zeile kopieren" Click="CopyTreeLine_Click" InputGestureText="Strg+C" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="DirectoryTabItem" Header="Verzeichnis">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,2">
                        <TextBlock Text="Suchen:" VerticalAlignment="Center" Margin="0,0,6,6" />
                        <TextBox x:Name="DirSearchBox" Width="220" Margin="0,0,0,6" VerticalContentAlignment="Center" KeyDown="DirSearch_KeyDown"
                                 ToolTip="Teil eines Namens, einer Klasse, eines Besitzers oder eine ID. Leer lassen für alles." />
                        <Button Content="Suchen" Margin="6,0,0,6" Click="DirSearch_Click" />
                        <ComboBox x:Name="DirModeBox" Margin="12,0,0,6" Width="110" VerticalContentAlignment="Center"
                                  SelectedIndex="0" SelectionChanged="DirFilter_Changed">
                            <ComboBoxItem Content="Objekte" />
                            <ComboBoxItem Content="Items" />
                        </ComboBox>
                        <ComboBox x:Name="DirFilterBox" Margin="12,0,0,6" Width="170" VerticalContentAlignment="Center"
                                  SelectedIndex="0" SelectionChanged="DirFilter_Changed">
                            <ComboBoxItem Content="Alles" />
                            <ComboBoxItem Content="Nur Mod-Inhalte" />
                            <ComboBoxItem Content="Nur angehakte Mods" />
                        </ComboBox>
                        <Button x:Name="DirBackButton" Content="← Zurück" Margin="6,0,0,6" IsEnabled="False" Click="Back_Click"
                                ToolTip="Zurück dorthin, von wo aus hierher gesprungen wurde." />
                    </WrapPanel>
                    <TextBlock x:Name="DirHint" DockPanel.Dock="Bottom" Style="{StaticResource Hint}" TextWrapping="Wrap"
                               Text="Was ist wo: alle Objekte und Item-Arten des Spielstands, geordnet nach Herkunft (Grundspiel, Mods) und Namen. Aufklappen zeigt Fundstellen, Besitzer und Inhalt; Koordinaten führen zur Karte, Doppelklick auf eine Fundstelle oder ein Item springt zu dessen Eintrag (auch mit Enter). Rechtsklick öffnet ein Menü (Karte, Eintrag, Teleport-Befehl, Zeile kopieren); Strg+C kopiert die Zeile. Gelb: aus Mods, rot: aus angehakten Mods." />
                    <TreeView x:Name="DirTree" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              MouseDoubleClick="DirTree_MouseDoubleClick" PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                              PreviewKeyDown="DirTree_PreviewKeyDown" ContextMenuOpening="DirTree_ContextMenuOpening">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="9" Height="9" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding Marker}" />
                                    <TextBlock Text="{Binding Text}" FontWeight="{Binding Weight}" Padding="3,1" Background="{Binding RowBackground}"
                                               Style="{StaticResource TreeRowText}" />
                                    <TextBlock Margin="8,1,0,0" Style="{StaticResource TreeCoordBox}"><Hyperlink Click="DirCoords_Click" ToolTip="Auf der Karte zeigen" Style="{StaticResource TreeCoordLink}"><Run Text="{Binding Coords, Mode=OneWay}" /></Hyperlink></TextBlock>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="DirShowOnMapItem" Header="Auf der Karte zeigen" Click="DirShowOnMap_Click" />
                                <MenuItem x:Name="DirOpenItem" Header="Zum Eintrag springen" Click="DirOpen_Click" InputGestureText="Doppelklick" />
                                <MenuItem x:Name="DirTeleportItem" Header="Teleport-Befehl kopieren" Click="DirTeleport_Click" />
                                <MenuItem x:Name="DirCopyLineItem" Header="Zeile kopieren" Click="DirCopyLine_Click" InputGestureText="Strg+C" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="MapTabItem" Header="Karte">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="270" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="#CCC" BorderThickness="1">
                            <local:MapView x:Name="Map" />
                        </Border>
                        <!-- Höhenschnitt: erscheint, sobald auf der Karte eine Schnittlinie gezogen ist -->
                        <Border x:Name="SectionPanel" Grid.Row="1" BorderBrush="#CCC" BorderThickness="1" Margin="0,6,0,0" Height="240" Visibility="Collapsed">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Top" Margin="6,4,6,2">
                                    <TextBlock x:Name="SectionTitle" VerticalAlignment="Center" FontWeight="SemiBold" Text="Höhenschnitt" Margin="0,0,16,2" />
                                    <!-- Tiefe des Streifens vor und hinter der Schnittlinie -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,2">
                                        <TextBlock Text="Vorne:" VerticalAlignment="Center" Margin="0,0,4,0"
                                                   ToolTip="Wie weit vor der Linie (zum Betrachter hin) Teile mitgezeigt werden. Der Pfeil auf der Karte zeigt die Blickrichtung." />
                                        <Slider x:Name="SectionFrontSlider" Width="150" Minimum="0" Maximum="4096" Value="256" TickFrequency="64"
                                                IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SectionDepth_Changed" />
                                        <TextBlock x:Name="SectionFrontText" Width="44" VerticalAlignment="Center" Margin="4,0,14,0" Text="256" />
                                        <TextBlock Text="Hinten:" VerticalAlignment="Center" Margin="0,0,4,0"
                                                   ToolTip="Wie weit hinter der Linie Teile mitgezeigt werden." />
                                        <Slider x:Name="SectionBackSlider" Width="150" Minimum="0" Maximum="4096" Value="256" TickFrequency="64"
                                                IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SectionDepth_Changed" />
                                        <TextBlock x:Name="SectionBackText" Width="44" VerticalAlignment="Center" Margin="4,0,0,0" Text="256" />
                                    </StackPanel>
                                    <Button Content="Schnitt schließen" Margin="0,0,0,2" Click="CloseSection_Click" />
                                </WrapPanel>
                                <local:SectionView x:Name="Section" />
                            </DockPanel>
                        </Border>
                    </Grid>
                    <!-- Seitenleiste: füllt die Höhe; bei langer Auswahl, offener Legende oder kleinem Fenster rollt sie -->
                    <ScrollViewer Grid.Column="1" Margin="10,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <local:FitGrid>
                        <local:FitGrid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="150" />
                            <RowDefinition Height="Auto" />
                        </local:FitGrid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <WrapPanel>
                                <Button Content="Ganze Karte" Margin="0,0,6,6" Click="MapFit_Click" />
                                <Button Content="Verbannte Lande" Margin="0,0,6,6" Tag="exiled" Click="MapIsland_Click" />
                                <Button Content="Siptah" Margin="0,0,6,6" Tag="siptah" Click="MapIsland_Click" />
                                <Button x:Name="ResetRotationButton" Content="Norden oben" Margin="0,0,6,6" Visibility="Collapsed" Click="ResetRotation_Click" />
                                <Button x:Name="MapBackButton" Content="← Zurück" Margin="0,0,6,6" IsEnabled="False" Click="Back_Click"
                                        ToolTip="Zurück dorthin, von wo aus hierher gesprungen wurde." />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,0"
                                       Text="Mausrad: zoomen · Ziehen: verschieben · Rechte Maustaste ziehen: Ausschnitt vergrößern · Strg + Ziehen: drehen · Umschalt + Ziehen: Höhenschnitt, danach A und B mit der Maus verschieben · Klick auf Gruppe oder Randpfeil: hinspringen" />

                            <GroupBox Header="Auswahl" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="MapInfoText" TextWrapping="Wrap" Text="Nichts ausgewählt." />
                                    <StackPanel x:Name="LevelPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                        <TextBlock Text="Grundriss – Ebene:" />
                                        <ComboBox x:Name="LevelBox" Margin="0,2,0,0" SelectionChanged="LevelBox_SelectionChanged" />
                                    </StackPanel>
                                    <WrapPanel>
                                        <Button x:Name="MapTeleportButton" Content="Teleport-Befehl kopieren" Margin="0,8,6,0" Visibility="Collapsed" Click="MapTeleport_Click" />
                                        <Button x:Name="MapDirectoryButton" Content="Im Verzeichnis zeigen" Margin="0,8,0,0" Visibility="Collapsed" Click="MapDirectory_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Anzeigen">
                                <StackPanel>
                                    <CheckBox x:Name="OnlyModsBox" Content="Nur Mod-Inhalte" FontWeight="SemiBold" Checked="MapFilter_Changed" Unchecked="MapFilter_Changed" />
                                    <CheckBox x:Name="ShowPlaceablesBox" Content="Platzierte Objekte" IsChecked="True" Margin="0,4,0,0" Checked="MapFilter_Changed" Unchecked="MapFilter_Changed" />
                                    <CheckBox x:Name="ShowFiguresBox" Content="Thralls und Tiere" IsChecked="True" Margin="0,4,0,0" Checked="MapFilter_Changed" Unchecked="MapFilter_Changed" />
                                    <CheckBox x:Name="ShowPlayersBox" Content="Spieler" IsChecked="True" Margin="0,4,0,0" Checked="MapFilter_Changed" Unchecked="MapFilter_Changed" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <Expander Grid.Row="2" Header="Legende" Margin="0,6,0,0">
                            <StackPanel x:Name="LegendPanel" Margin="0,4,0,0" />
                        </Expander>

                        <GroupBox Grid.Row="1" Header="Fundstellen von Mod-Inhalten">
                            <DockPanel>
                                <TextBlock x:Name="FindingsHint" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,4"
                                           Text="Klick springt zur Stelle." />
                                <ListBox x:Name="FindingsList" SelectionChanged="Findings_SelectionChanged" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                                <Ellipse Width="9" Height="9" Fill="{Binding Brush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="215" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </GroupBox>
                    </local:FitGrid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Bericht">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Bericht speichern …" Click="SaveReport_Click" />
                        <Button Content="Kopieren" Margin="6,0,0,0" Click="CopyReport_Click" />
                    </StackPanel>
                    <FlowDocumentScrollViewer x:Name="ReportView" PreviewMouseWheel="DocumentView_MouseWheel" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                              BorderBrush="#CCC" BorderThickness="1" />
                </DockPanel>
            </TabItem>

            <TabItem x:Name="CleanupTab" Header="Bereinigung">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <CheckBox x:Name="IncludeContentsBox" Checked="IncludeContents_Changed" Unchecked="IncludeContents_Changed">
                            <TextBlock TextWrapping="Wrap" Text="Mod-Behälter auch dann entfernen, wenn noch andere Items darin liegen" />
                        </CheckBox>
                        <CheckBox x:Name="IncludeOrphansBox" Margin="0,6,0,0" Checked="IncludeContents_Changed" Unchecked="IncludeContents_Changed">
                            <TextBlock TextWrapping="Wrap" Text="Reste ohne Besitzer mit entfernen (Items in Behältern, die es nicht mehr gibt; siehe Bericht)" />
                        </CheckBox>
                        <DockPanel Margin="0,8,0,0">
                            <Button x:Name="ApplyButton" DockPanel.Dock="Left" Content="Jetzt bereinigen …" FontWeight="SemiBold"
                                    IsEnabled="False" Click="Apply_Click" />
                            <TextBlock Style="{StaticResource Notice}" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Text="Vorher wird automatisch eine Sicherungskopie neben dem Spielstand angelegt. Der Server muss gestoppt sein." />
                        </DockPanel>
                    </StackPanel>
                    <FlowDocumentScrollViewer x:Name="PreviewView" PreviewMouseWheel="DocumentView_MouseWheel" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                              BorderBrush="#CCC" BorderThickness="1" />
                </DockPanel>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Background="Transparent">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Spielstand auswählen und auf „Prüfen“ klicken." />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
