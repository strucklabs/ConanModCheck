<Window x:Class="ConanModCheck.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ConanModCheck.Gui"
        Title="ConanModCheck – Mod-Reste im Spielstand finden und entfernen"
        Width="1180" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/ConanModCheck.ico"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Linke Spalte: Auswahl -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <Image Source="{StaticResource Logo}" Width="40" Height="40" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ConanModCheck" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Mod-Reste im Spielstand finden und entfernen" Foreground="#666" />
                </StackPanel>
            </StackPanel>
            <GroupBox Header="1. Spielstand (game.db)" DockPanel.Dock="Top">
                <StackPanel>
                    <TextBlock x:Name="DbPathText" Text="Noch keiner ausgewählt" TextWrapping="Wrap" />
                    <Button Content="Spielstand auswählen …" HorizontalAlignment="Left" Margin="0,8,0,0" Click="ChooseDb_Click" />
                    <TextBlock Style="{StaticResource Notice}"
                               Text="Liegt beim Server unter ConanSandbox\Saved. Den Server vor dem Kopieren stoppen. Am besten mit einer Kopie arbeiten." />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="2. Mod-Dateien (optional)" DockPanel.Dock="Top">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}"
                               Text="Zip, .pak oder .utoc der Mods, die entfernt werden sollen. Nur mit der Mod-Datei lassen sich auch ihre Items finden. Dateien lassen sich hierher ziehen." />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Hinzufügen …" Click="AddMods_Click" />
                        <Button Content="Ordner …" Margin="6,0,0,0" Click="AddModFolder_Click"
                                ToolTip="Einen ganzen Ordner mit Mods, z. B. ConanSandbox\Saved\ExtractedMods" />
                        <Button Content="Entfernen" Margin="6,0,0,0" Click="RemoveMod_Click" />
                    </StackPanel>
                    <ListBox x:Name="ModList" MinHeight="90" SelectionMode="Extended" />
                </DockPanel>
            </GroupBox>

            <Button x:Name="AnalyzeButton" DockPanel.Dock="Top" Content="Prüfen" FontWeight="SemiBold"
                    MinHeight="36" IsDefault="True" Click="Analyze_Click" />

            <Expander Header="Einstellungen" DockPanel.Dock="Top" Margin="0,12,0,0">
                <Border Margin="0,6,0,0" Padding="10" Background="#F5F5F3" BorderBrush="#DDDAD2" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Conan Exiles-Ordner (leer = über Steam suchen)" />
                    <DockPanel Margin="0,2,0,8">
                        <Button DockPanel.Dock="Right" Content="…" Padding="8,2" Margin="4,0,0,0" Click="ChooseGame_Click" />
                        <TextBox x:Name="GameDirBox" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="Oodle-DLL (leer = automatisch suchen)" />
                    <DockPanel Margin="0,2,0,0">
                        <Button DockPanel.Dock="Right" Content="…" Padding="8,2" Margin="4,0,0,0" Click="ChooseOodle_Click" />
                        <TextBox x:Name="OodleBox" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="OodleInfoText" TextWrapping="Wrap" Margin="0,6,0,0" Text="Oodle wird beim Prüfen gesucht." />
                    <Button x:Name="CopyOodleButton" Content="Neben das Programm kopieren" HorizontalAlignment="Left"
                            Margin="0,6,0,0" Visibility="Collapsed" Click="CopyOodle_Click" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Mod- und Spieldateien sind mit Oodle gepackt. Die Bibliothek oo2core_*_win64.dll liegt vielen anderen Spielen bei." />
                </StackPanel>
                </Border>
            </Expander>

            <GroupBox Header="Verlauf" Margin="0,12,0,0">
                <TextBox x:Name="LogBox" Style="{StaticResource ReportBox}" FontSize="11.5" BorderThickness="0" TextWrapping="Wrap" />
            </GroupBox>
        </DockPanel>

        <!-- Rechte Spalte: Ergebnisse -->
        <TabControl x:Name="Tabs" Grid.Column="2">
            <TabItem Header="Übersicht">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Alle Mod-Ordner, von denen etwas im Spielstand steckt. Haken bei allem setzen, was entfernt werden soll. Bericht und Vorschau richten sich nach dieser Auswahl." />
                    <DataGrid x:Name="FolderGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                              HorizontalGridLinesBrush="#DDD" RowHeight="24">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Entfernen" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Remove, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Mod-Ordner" Binding="{Binding Folder}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Mod-Controller" Binding="{Binding ControllerMark}" Width="95" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Objekte" Binding="{Binding Objects}" Width="70" IsReadOnly="True" />
                            <DataGridTextColumn Header="Bauteile" Binding="{Binding Pieces}" Width="70" IsReadOnly="True" />
                            <DataGridTextColumn Header="Mod-Daten" Binding="{Binding Props}" Width="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="Effekte" Binding="{Binding Buffs}" Width="65" IsReadOnly="True" />
                            <DataGridTextColumn Header="Mod-Datei" Binding="{Binding ModName}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Besitz">
                <DockPanel Margin="8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Als Text speichern …" Margin="6,0,0,0" Click="SaveOwnership_Click" />
                        <ComboBox x:Name="ItemFilterBox" DockPanel.Dock="Right" Margin="12,0,0,0" Width="190" VerticalContentAlignment="Center"
                                  SelectedIndex="0" SelectionChanged="ItemFilter_Changed">
                            <ComboBoxItem Content="Alle Items" />
                            <ComboBoxItem Content="Items aus allen Mods" />
                            <ComboBoxItem Content="Items aus geladenen Mods" />
                            <ComboBoxItem Content="Items aus angehakten Mods" />
                        </ComboBox>
                        <Button DockPanel.Dock="Right" Content="Suchen" Margin="6,0,0,0" Click="SearchOwnership_Click" />
                        <TextBlock DockPanel.Dock="Left" Text="Item suchen:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="OwnershipSearchBox" VerticalContentAlignment="Center" KeyDown="OwnershipSearch_KeyDown"
                                 ToolTip="Teil eines Item- oder Mod-Namens, z. B. „Sternenmetall“. Leer lassen für alles." />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}"
                               Text="Zahlen in eckigen Klammern sind Stückzahlen, Namen in eckigen Klammern die Mod, aus der ein Item stammt. Rechtsklick auf ein Objekt kopiert den Teleport-Befehl für die Admin-Konsole." />
                    <TreeView x:Name="OwnershipTree" VirtualizingStackPanel.IsVirtualizing="True" PreviewMouseRightButtonDown="OwnershipTree_PreviewMouseRightButtonDown">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Text}" FontWeight="{Binding Weight}" Padding="0,1" />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="CopyTeleportItem" Header="Teleport-Befehl kopieren" Click="CopyTeleport_Click" />
                                <MenuItem Header="Zeile kopieren" Click="CopyTreeLine_Click" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </DockPanel>
            </TabItem>

            <TabItem Header="Karte">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="250" />
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="#CCC" BorderThickness="1">
                        <local:MapView x:Name="Map" />
                    </Border>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="10,0,0,0">
                        <StackPanel>
                            <WrapPanel>
                                <Button Content="Ganze Karte" Margin="0,0,6,6" Click="MapFit_Click" />
                                <Button Content="Heranzoomen" Margin="0,0,6,6" Click="MapZoom_Click" />
                                <Button Content="Verbannte Lande" Margin="0,0,6,6" Tag="exiled" Click="MapIsland_Click" />
                                <Button Content="Siptah" Margin="0,0,6,6" Tag="siptah" Click="MapIsland_Click" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="Mausrad: zoomen · Ziehen: verschieben · Klick: Gebäude oder Objekt auswählen" />

                            <GroupBox Header="Auswahl" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="MapInfoText" TextWrapping="Wrap" Text="Nichts ausgewählt." />
                                    <StackPanel x:Name="LevelPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                        <TextBlock Text="Grundriss – Ebene:" />
                                        <ComboBox x:Name="LevelBox" Margin="0,2,0,0" SelectionChanged="LevelBox_SelectionChanged" />
                                    </StackPanel>
                                    <Button x:Name="MapTeleportButton" Content="Teleport-Befehl kopieren" HorizontalAlignment="Left"
                                            Margin="0,8,0,0" Visibility="Collapsed" Click="MapTeleport_Click" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Anzeigen">
                                <StackPanel>
                                    <CheckBox x:Name="ShowPlaceablesBox" Content="Platzierte Objekte" IsChecked="True" Checked="MapFilter_Changed" Unchecked="MapFilter_Changed" />
                                    <CheckBox x:Name="ShowFiguresBox" Content="Thralls und Tiere" IsChecked="True" Margin="0,4,0,0" Checked="MapFilter_Changed" Unchecked="MapFilter_Changed" />
                                    <CheckBox x:Name="ShowPlayersBox" Content="Spieler" IsChecked="True" Margin="0,4,0,0" Checked="MapFilter_Changed" Unchecked="MapFilter_Changed" />
                                    <CheckBox x:Name="ShowMapImageBox" Content="Spielkarte im Hintergrund" IsChecked="True" Margin="0,4,0,0" Checked="MapFilter_Changed" Unchecked="MapFilter_Changed" />
                                    <ToggleButton x:Name="AlignMapButton" Content="Karte ausrichten" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,3"
                                                  Checked="AlignMap_Changed" Unchecked="AlignMap_Changed" />
                                    <TextBlock x:Name="AlignHint" Style="{StaticResource Hint}" Visibility="Collapsed"
                                               Text="Kartenbild mit der Maus verschieben, Mausrad: Größe, Strg + Mausrad: Drehung. Oder Werte unten eintragen. Alles wird gespeichert." />
                                    <Grid x:Name="AlignPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Insel" VerticalAlignment="Center" Margin="0,0,8,4" />
                                        <ComboBox x:Name="AlignIslandBox" Grid.Column="1" Margin="0,0,0,4" SelectionChanged="AlignIsland_Changed" />
                                        <TextBlock Grid.Row="1" Text="Versatz X" VerticalAlignment="Center" Margin="0,0,8,4" />
                                        <TextBox x:Name="AlignX" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" LostFocus="AlignValue_Commit" KeyDown="AlignValue_KeyDown" GotKeyboardFocus="AlignValue_Focus" PreviewMouseLeftButtonDown="AlignValue_MouseDown" />
                                        <TextBlock Grid.Row="2" Text="Versatz Y" VerticalAlignment="Center" Margin="0,0,8,4" />
                                        <TextBox x:Name="AlignY" Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" LostFocus="AlignValue_Commit" KeyDown="AlignValue_KeyDown" GotKeyboardFocus="AlignValue_Focus" PreviewMouseLeftButtonDown="AlignValue_MouseDown" />
                                        <TextBlock Grid.Row="3" Text="Maßstab %" VerticalAlignment="Center" Margin="0,0,8,4" />
                                        <TextBox x:Name="AlignScale" Grid.Row="3" Grid.Column="1" Margin="0,0,0,4" LostFocus="AlignValue_Commit" KeyDown="AlignValue_KeyDown" GotKeyboardFocus="AlignValue_Focus" PreviewMouseLeftButtonDown="AlignValue_MouseDown" />
                                        <TextBlock Grid.Row="4" Text="Drehung °" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox x:Name="AlignAngle" Grid.Row="4" Grid.Column="1" LostFocus="AlignValue_Commit" KeyDown="AlignValue_KeyDown" GotKeyboardFocus="AlignValue_Focus" PreviewMouseLeftButtonDown="AlignValue_MouseDown" />
                                    </Grid>
                                    <Button x:Name="ResetAlignButton" Content="Ausrichtung zurücksetzen" HorizontalAlignment="Left" Margin="0,6,0,0"
                                            Visibility="Collapsed" Click="ResetAlign_Click" />
                                    <TextBlock x:Name="MapImageStatus" Style="{StaticResource Hint}" Visibility="Collapsed" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Legende">
                                <StackPanel x:Name="LegendPanel" />
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Bericht">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Bericht speichern …" Click="SaveReport_Click" />
                        <Button Content="Kopieren" Margin="6,0,0,0" Click="CopyReport_Click" />
                    </StackPanel>
                    <FlowDocumentScrollViewer x:Name="ReportView" PreviewMouseWheel="DocumentView_MouseWheel" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                              BorderBrush="#CCC" BorderThickness="1" />
                </DockPanel>
            </TabItem>

            <TabItem x:Name="CleanupTab" Header="Bereinigung">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <CheckBox x:Name="IncludeContentsBox" Content="Mod-Behälter auch dann entfernen, wenn noch andere Items darin liegen"
                                  Checked="IncludeContents_Changed" Unchecked="IncludeContents_Changed" />
                        <CheckBox x:Name="IncludeOrphansBox" Margin="0,6,0,0"
                                  Content="Reste ohne Besitzer mit entfernen (Items in Behältern, die es nicht mehr gibt; siehe Bericht)"
                                  Checked="IncludeContents_Changed" Unchecked="IncludeContents_Changed" />
                        <DockPanel Margin="0,8,0,0">
                            <Button x:Name="ApplyButton" DockPanel.Dock="Left" Content="Jetzt bereinigen …" FontWeight="SemiBold"
                                    IsEnabled="False" Click="Apply_Click" />
                            <TextBlock Style="{StaticResource Notice}" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Text="Vorher wird automatisch eine Sicherungskopie neben dem Spielstand angelegt. Der Server muss gestoppt sein." />
                        </DockPanel>
                    </StackPanel>
                    <FlowDocumentScrollViewer x:Name="PreviewView" PreviewMouseWheel="DocumentView_MouseWheel" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                              BorderBrush="#CCC" BorderThickness="1" />
                </DockPanel>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Background="Transparent">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Spielstand auswählen und auf „Prüfen“ klicken." />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
